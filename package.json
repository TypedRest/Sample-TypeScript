{
  "name": "address-book",
  "private": true,
  "type": "module",
  "workspaces": [
    "dto",
    "client",
    "service",
    "web"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces",

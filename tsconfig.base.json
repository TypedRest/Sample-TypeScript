{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    // Node.js runs the .ts files directly by stripping types
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "types": []
  }
}
